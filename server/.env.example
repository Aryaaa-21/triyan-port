# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---------------------------------------------------------------- database
# MongoDB Atlas SRV string. Never commit the real value.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=triyan_dev

# ---------------------------------------------------------------- client
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# ISR invalidation hook on the Next.js app.
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------- instagram
# `mock` uses the in-repo mock provider and never contacts Instagram.
# `graph` uses the official Instagram API with Instagram Login (graph.instagram.com).
INSTAGRAM_PROVIDER=mock
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_USERNAME=triyanwrites

# ---------------------------------------------------------------- media
MEDIA_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------- jobs
SYNC_ENABLED=false
SYNC_CRON=*/30 * * * *
