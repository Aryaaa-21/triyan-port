# Read by Vite at build time. Only VITE_* values reach the browser.
# Both are optional: the site URL falls back to wherever the site is served from.
VITE_SITE_URL=http://localhost:3000
VITE_SITE_NAME=Triyan

# Development only: where `vite` proxies /api, /sitemap.xml and /robots.txt.
API_PROXY_TARGET=http://localhost:4000
